{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Pico (RP2040) — Debug Probe / SWD",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/src/blink.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "gdbPath": "gdb-multiarch",
            "rtos": "FreeRTOS",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        },
        {
